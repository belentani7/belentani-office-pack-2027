{
  "name": "belentani-office-pack",
  "version": "0.1.0",
  "description": "Belentani Office Pack 2027 — suite local-first de documentos, hojas y canvas.",
  "main": "electron/main.cjs",
  "author": "Belentani Contributors",
  "license": "MPL-2.0",
  "type": "module",
  "desktopName": "belentani-office",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --linux AppImage --x64",
    "dist:win": "pnpm build && electron-builder --win portable --x64",
    "dist:win:installer": "pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "org.belentani.office",
    "productName": "Belentani Office Pack",
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Belentani-Office-Pack-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Belentani-Office-Pack-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Belentani-Office-Pack-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Office",
      "syncDesktopName": true,
      "synopsis": "Suite ofimática local-first con documentos, hojas y canvas",
      "target": ["AppImage"],
      "artifactName": "Belentani-Office-Pack-${version}-${arch}.${ext}"
    }
  }
}
